{
    "name": "silverstripe/silverstripe-search-service",
    "description": "Abstract Search Service with Elastic Enterprise Search Functionality",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Will Rossiter",
            "email": "will@fullscreen.io"
        },
        {
            "name": "Aaron Carlino",
            "email": "aaron@silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "elastic/enterprise-search": "^8.3",
        "guzzlehttp/guzzle": "^7",
        "silverstripe/cms": "^6",
        "silverstripe/versioned": "^3",
        "symbiote/silverstripe-queuedjobs": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/subsites": "^4",
        "slevomat/coding-standard": "^8.18"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\SearchService\\": "src/",
            "SilverStripe\\SearchService\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "extra": {
        "project-files-installed": [
            "behat.yml",
            "phpunit.xml.dist"
        ]
    }
}
